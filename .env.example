# ===========================================
# InterviewAI - Environment Configuration
# ===========================================

# AI Provider: "ibm_granite" or "mock"
# Use "mock" for local development without IBM credentials
# Use "ibm_granite" for production with IBM watsonx.ai
AI_PROVIDER=ibm_granite

# IBM watsonx.ai Credentials
IBM_API_KEY=your_api_key_here
IBM_PROJECT_ID=your_project_id_here
IBM_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-3-8b-instruct

# Database
DATABASE_URL=sqlite:///./interview_ai.db

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Application URLs
FRONTEND_URL=http://localhost:3000

BACKEND_URL=http://localhost:8000
