# ===========================================
# InterviewAI - Environment Configuration
# ===========================================

# AI Provider: "gemini" or "mock"
# Use "gemini" in production or local development with GEMINI_API_KEY
# Use "mock" for offline local testing
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
# Local SQLite (default):
DATABASE_URL=sqlite:///./interview_ai.db
# Production PostgreSQL (e.g. Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://user:password@host/dbname

# ChromaDB / Cache Directory
CHROMA_PERSIST_DIR=./chroma_db

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
